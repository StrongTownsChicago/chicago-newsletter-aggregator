---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import NewsletterCard from '../components/NewsletterCard.astro';
import Pagination from '../components/Pagination.astro';
import { supabase } from '../lib/supabase';
import { UNCACHEABLE_PAGE_CACHE_CONTROL } from '../lib/page-cache';
import { buildNewsletterCardSelect, buildNewsletterCountSelect } from '../lib/newsletter-queries';
import type { NewsletterCardRow } from '../lib/newsletter-queries';

// Pagination setup
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const PAGE_SIZE = 20;
const start = (page - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE - 1;

// Get total count
const { count, error: countError } = await supabase
  .from('newsletters')
  .select(buildNewsletterCountSelect({ filtersOnSource: false }), { count: 'exact', head: true });

const totalPages = Math.ceil((count || 0) / PAGE_SIZE);

// Get paginated newsletters
const { data, error } = await supabase
  .from('newsletters')
  .select(buildNewsletterCardSelect({ filtersOnSource: false }))
  .order('received_date', { ascending: false })
  .range(start, end);
const newsletters = data as NewsletterCardRow[] | null;

if (error) {
  console.error('Error fetching newsletters:', error);
}
if (error || countError) {
  // Keep a failed load out of the edge page cache.
  Astro.response.headers.set('Cache-Control', UNCACHEABLE_PAGE_CACHE_CONTROL);
}
---

<Layout
  title="Chicago Alderman Newsletter Tracker"
  description="A searchable archive of newsletters from Chicago aldermen. See what aldermen tell their wards about housing, transit, zoning, and more."
  canonicalPage={page}
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <header class="mb-6">
      {count !== null && (
        <p class="text-base sm:text-lg text-gray-600" data-testid="newsletter-count">
          Browse {count} newsletter{count !== 1 ? 's' : ''} that aldermen sent to their wards, newest first.
        </p>
      )}
    </header>

    <section>
      <div class="space-y-4">
        {newsletters?.length === 0 && (
          <p class="text-gray-600 text-center py-12">No newsletters found.</p>
        )}
        {newsletters?.map((newsletter) => (
          <NewsletterCard newsletter={newsletter} />
        ))}
      </div>

      <Pagination currentPage={page} totalPages={totalPages} baseUrl="/" />
    </section>
  </div>
</Layout>