---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import NewsletterCard from '../components/NewsletterCard.astro';
import Pagination from '../components/Pagination.astro';
import StatusMessage from '../components/StatusMessage.astro';
import { supabase } from '../lib/supabase';
import { UNCACHEABLE_PAGE_CACHE_CONTROL } from '../lib/server/page-cache';
import { buildNewsletterCardSelect, buildNewsletterCountSelect } from '../lib/server/newsletter-queries';
import type { NewsletterCardRow } from '../lib/server/newsletter-queries';
import { countPages, getPageRange, parsePageParam } from '../lib/pagination';
import { HOME_PATH } from '../lib/site';
import {
  LOAD_FAILED_MESSAGE,
  LOAD_FAILED_TITLE,
  PAGE_OUT_OF_RANGE_MESSAGE,
  PAGE_OUT_OF_RANGE_TITLE,
} from '../lib/load-messages';

const page = parsePageParam(Astro.url.searchParams.get('page'));
const { from: start, to: end } = getPageRange(page);

// Get total count
const { count, error: countError } = await supabase
  .from('newsletters')
  .select(buildNewsletterCountSelect({ filtersOnSource: false }), { count: 'exact', head: true });

const totalPages = countPages(count ?? 0);

// Get paginated newsletters
const { data, error } = await supabase
  .from('newsletters')
  .select(buildNewsletterCardSelect({ filtersOnSource: false }))
  .order('received_date', { ascending: false })
  .range(start, end);
const newsletters = data as NewsletterCardRow[] | null;

// Cards that loaded still show when only the count failed; an empty page without a count reads as a failure.
const loadFailed = Boolean(error) || (Boolean(countError) && newsletters?.length === 0);
if (error || countError) {
  console.error('Error fetching newsletters:', error ?? countError);
  if (loadFailed) Astro.response.status = 503;
  // Keep a failed or partial load out of the edge page cache.
  Astro.response.headers.set('Cache-Control', UNCACHEABLE_PAGE_CACHE_CONTROL);
}
---

<Layout
  title="Chicago Alderman Newsletter Tracker"
  description="A searchable archive of newsletters from Chicago aldermen. See what aldermen tell their wards about housing, transit, zoning, and more."
  canonicalPage={page}
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <header class="mb-6">
      {!loadFailed && count !== null && (
        <p class="text-base sm:text-lg text-gray-600" data-testid="newsletter-count">
          Browse {count} newsletter{count !== 1 ? 's' : ''} that aldermen sent to their wards, newest first.
        </p>
      )}
    </header>

    <section>
      {loadFailed ? (
        <StatusMessage title={LOAD_FAILED_TITLE} message={LOAD_FAILED_MESSAGE} alert testId="newsletters-load-error" />
      ) : count === 0 ? (
        <StatusMessage
          title="No newsletters yet"
          message="Newsletters will appear here as aldermen send them."
          testId="newsletters-empty"
        />
      ) : newsletters?.length === 0 ? (
        <StatusMessage
          title={PAGE_OUT_OF_RANGE_TITLE}
          message={PAGE_OUT_OF_RANGE_MESSAGE}
          testId="newsletters-page-empty"
        />
      ) : (
        <div class="space-y-4">
          {newsletters?.map((newsletter) => (
            <NewsletterCard newsletter={newsletter} />
          ))}
        </div>
      )}

      {!loadFailed && <Pagination currentPage={page} totalPages={totalPages} baseUrl={HOME_PATH} />}
    </section>
  </div>
</Layout>