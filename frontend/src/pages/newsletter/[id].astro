---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import NewsletterDetail from '../../components/NewsletterDetail.astro';
import StatusMessage from '../../components/StatusMessage.astro';
import { supabase } from '../../lib/supabase';
import {
  NEWSLETTER_DETAIL_SELECT,
  isNewsletterId,
  isNewsletterMissing,
  type NewsletterDetailRow,
} from '../../lib/server/newsletter-queries';
import { UNCACHEABLE_PAGE_CACHE_CONTROL } from '../../lib/server/page-cache';
import { SITE_NAME, buildNewsletterDescription } from '../../lib/seo';

const { id } = Astro.params;

const lookup = isNewsletterId(id)
  ? await supabase.from('newsletters').select(NEWSLETTER_DETAIL_SELECT).eq('id', id).single<NewsletterDetailRow>()
  : null;
const newsletter = lookup?.data ?? null;
const missing = lookup === null || isNewsletterMissing(lookup.error, newsletter);

if (!newsletter) {
  if (missing) {
    Astro.response.status = 404;
  } else {
    console.error(`Error loading newsletter ${id}:`, lookup?.error);
    Astro.response.status = 503;
    // Keep a failed load out of the edge page cache.
    Astro.response.headers.set('Cache-Control', UNCACHEABLE_PAGE_CACHE_CONTROL);
  }
}
---

{newsletter ? (
  <Layout
    title={`${newsletter.subject} - ${SITE_NAME}`}
    description={buildNewsletterDescription(newsletter)}
    type="article"
  >
    <div class="container mx-auto px-4 py-8 max-w-4xl">
      <NewsletterDetail newsletter={newsletter} />
    </div>
  </Layout>
) : missing ? (
  <Layout title={`Newsletter not found - ${SITE_NAME}`} description="This newsletter doesn't exist or was removed.">
    <NotFound title="Newsletter not found" message="This newsletter doesn't exist or was removed." />
  </Layout>
) : (
  <Layout title={`Newsletter unavailable - ${SITE_NAME}`} description="This newsletter couldn't be loaded.">
    <div class="container mx-auto px-4 py-8 max-w-4xl">
      <h1 class="sr-only">Newsletter unavailable</h1>
      <StatusMessage
        title="This newsletter couldn't be loaded"
        message="Something went wrong on our end. Reload the page or try again in a few minutes."
        alert
        testId="newsletter-load-error"
      />
    </div>
  </Layout>
)}
