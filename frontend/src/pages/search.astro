---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import NewsletterCard from '../components/NewsletterCard.astro';
import Pagination from '../components/Pagination.astro';
import SearchTimeline from '../components/SearchTimeline.astro';
import StatusMessage from '../components/StatusMessage.astro';
import {
  LOAD_FAILED_MESSAGE,
  LOAD_FAILED_TITLE,
  PAGE_OUT_OF_RANGE_MESSAGE,
  PAGE_OUT_OF_RANGE_TITLE,
} from '../lib/load-messages';
import { supabase } from '../lib/supabase';
import { UNCACHEABLE_PAGE_CACHE_CONTROL } from '../lib/server/page-cache';
import { buildNewsletterCardSelect, buildNewsletterCountSelect } from '../lib/server/newsletter-queries';
import type { NewsletterCardRow } from '../lib/server/newsletter-queries';
import { TOPIC_CATEGORIES, formatTopicLabel } from '../lib/topics';
import {
  SEARCH_PAGE_SIZE,
  SEARCH_PARAM_NAMES,
  SEARCH_SORTS,
  SEARCH_SORT_LABELS,
  applySearchFilters,
  applySearchSort,
  buildSearchBaseUrl,
  buildSearchUrlWithoutFilters,
  getPageRange,
  listActiveSearchFilters,
  parseSearchParams,
  requiresSourceJoin,
} from '../lib/search-filters';
import {
  SEARCH_SOURCE_COLUMNS,
  buildSourceNames,
  buildWardOptions,
} from '../lib/server/search-form-options';
import type { SearchSourceRow } from '../lib/server/search-form-options';
import {
  buildSearchUrlWithoutDates,
  normalizeTimelineQuery,
  selectedTimelineMonth,
  timelineRangeForSearch,
} from '../lib/search-timeline';

const { filters, sort, page } = parseSearchParams(Astro.url.searchParams);
const filtersOnSource = requiresSourceJoin(filters);
const { start, end } = getPageRange(page);

const unfilteredCountQuery = supabase
  .from('newsletters')
  .select(buildNewsletterCountSelect({ filtersOnSource }), { count: 'exact', head: true });
const countQuery = applySearchFilters(unfilteredCountQuery, filters);

const unfilteredDataQuery = supabase
  .from('newsletters')
  .select(buildNewsletterCardSelect({ filtersOnSource }));
const filteredDataQuery = applySearchFilters(unfilteredDataQuery, filters);
const dataQuery = applySearchSort(filteredDataQuery, sort);

const sourcesQuery = supabase
  .from('sources')
  .select(SEARCH_SOURCE_COLUMNS.join(', '))
  .overrideTypes<SearchSourceRow[], { merge: false }>();

const [
  { count, error: countError },
  { data, error: dataError },
  { data: sourceData, error: sourcesError },
] = await Promise.all([countQuery, dataQuery.range(start, end), sourcesQuery]);

const newsletters = data as NewsletterCardRow[] | null;
// Results that loaded still show when only the count failed; an empty page without a count reads as a failure.
const resultsFailed = Boolean(dataError) || (Boolean(countError) && newsletters?.length === 0);
if (countError || dataError || sourcesError) {
  console.error('Error loading search results:', countError ?? dataError ?? sourcesError);
  if (resultsFailed) Astro.response.status = 503;
  // Keep a failed or partial load out of the edge page cache.
  Astro.response.headers.set('Cache-Control', UNCACHEABLE_PAGE_CACHE_CONTROL);
}

const totalPages = Math.ceil((count || 0) / SEARCH_PAGE_SIZE);

const sources = sourceData ?? [];
const wardOptions = buildWardOptions(sources);
// Keep a ward from the URL selected even without a listed source, so searching again doesn't drop it.
const wardFilterHasNoOption =
  filters.ward !== null && !wardOptions.some(({ ward }) => ward === filters.ward);
const activeFilters = listActiveSearchFilters(filters, sort, buildSourceNames(sources));
const clearFiltersUrl = buildSearchUrlWithoutFilters(filters, sort);

const baseUrl = buildSearchBaseUrl(filters, sort);
const timelineQuery = !resultsFailed && (count ?? 0) > 0 ? normalizeTimelineQuery(filters.query) : null;
const timelineRange = timelineRangeForSearch(filters.fromDate, filters.toDate);
const timelineSelectedMonth = selectedTimelineMonth(filters.fromDate, filters.toDate);
const timelineHasOtherFilters = Boolean(
  filters.ward || filters.sourceId || filters.sourceType || filters.topic,
);

const inputClass =
  'w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-600 focus:border-blue-600';
const labelClass = 'block text-sm font-semibold text-gray-700 mb-1';
---

<Layout
  title="Search - Chicago Alderman Newsletter Tracker"
  description="Search Chicago alderman newsletters by keyword, ward, alderman, and topic."
>
  <div class="container mx-auto px-4 py-6 sm:py-8 max-w-6xl">
    <!-- Header -->
    <header class="mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">
        Search Newsletters
      </h1>
      <p class="text-base sm:text-lg text-gray-600">
        Filter and search through Chicago alderman newsletters
      </p>
    </header>

    <form method="get" role="search" class="bg-white rounded-lg shadow-md p-4 sm:p-6 mb-8 border border-gray-200">
      <div class="flex gap-2">
        <label for="search-query" class="sr-only">Search Keywords</label>
        <input
          id="search-query"
          type="search"
          name={SEARCH_PARAM_NAMES.query}
          value={filters.query}
          placeholder="Search newsletters..."
          class={`${inputClass} min-w-0 flex-1 py-2.5`}
          data-testid="search-input"
        />
        <button
          type="submit"
          class="shrink-0 px-5 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm"
          data-testid="search-button"
        >
          Search
        </button>
      </div>

      <!-- Source filters have no dropdown of their own; keep one that arrived in the URL. -->
      {filters.sourceId !== null && (
        <input type="hidden" name={SEARCH_PARAM_NAMES.sourceId} value={filters.sourceId} />
      )}
      {filters.sourceType !== null && (
        <input type="hidden" name={SEARCH_PARAM_NAMES.sourceType} value={filters.sourceType} />
      )}

      <details class="group mt-3" data-testid="search-filters">
        <summary
          class="inline-flex cursor-pointer list-none items-center gap-2 rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 [&::-webkit-details-marker]:hidden"
          data-testid="search-filters-toggle"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4" />
          </svg>
          Filters
          {activeFilters.length > 0 && (
            <span class="rounded-full bg-blue-600 px-2 text-xs leading-5 text-white" data-testid="active-filter-count">
              <span class="sr-only">(</span>{activeFilters.length}<span class="sr-only"> active)</span>
            </span>
          )}
          <svg class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
          </svg>
        </summary>

        <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-[3fr_4fr_2fr_2fr_2fr]">
          <div class="col-span-2 sm:col-span-1">
            <label for="search-topic" class={labelClass}>Topic</label>
            <select id="search-topic" name={SEARCH_PARAM_NAMES.topic} class={inputClass} data-testid="topic-filter">
              <option value="">All Topics</option>
              {Object.entries(TOPIC_CATEGORIES).map(([category, topics]) => (
                <optgroup label={category}>
                  {topics.map((topic) => (
                    <option value={topic} selected={filters.topic === topic}>
                      {formatTopicLabel(topic)}
                    </option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label for="search-ward" class={labelClass}>Ward / Alderman</label>
            <select id="search-ward" name={SEARCH_PARAM_NAMES.ward} class={inputClass} data-testid="ward-filter">
              <option value="">All Wards</option>
              {wardFilterHasNoOption && (
                <option value={filters.ward} selected>Ward {filters.ward}</option>
              )}
              {wardOptions.map(({ ward, label }) => (
                <option value={ward} selected={filters.ward === ward}>{label}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="search-from-date" class={labelClass}>Received From</label>
            <input
              id="search-from-date"
              type="date"
              name={SEARCH_PARAM_NAMES.fromDate}
              value={filters.fromDate ?? ''}
              class={inputClass}
              data-testid="from-date-filter"
            />
          </div>

          <div>
            <label for="search-to-date" class={labelClass}>Received To</label>
            <input
              id="search-to-date"
              type="date"
              name={SEARCH_PARAM_NAMES.toDate}
              value={filters.toDate ?? ''}
              class={inputClass}
              data-testid="to-date-filter"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label for="search-sort" class={labelClass}>Sort By</label>
            <select id="search-sort" name={SEARCH_PARAM_NAMES.sort} class={inputClass} data-testid="sort-select">
              {SEARCH_SORTS.map((sortOption) => (
                <option value={sortOption} selected={sort === sortOption}>
                  {SEARCH_SORT_LABELS[sortOption]}
                </option>
              ))}
            </select>
          </div>
        </div>

        <button
          type="submit"
          class="mt-4 px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm"
          data-testid="apply-filters-button"
        >
          Apply Filters
        </button>
      </details>

      {activeFilters.length > 0 && (
        <ul class="mt-3 flex flex-wrap items-center gap-2" aria-label="Active filters" data-testid="active-filters">
          {activeFilters.map(({ label, removeUrl }) => (
            <li>
              <a
                href={removeUrl}
                class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-3 py-1 text-sm text-blue-800 hover:bg-blue-100"
                aria-label={`Remove filter: ${label}`}
                data-testid="active-filter"
              >
                {label}
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
                </svg>
              </a>
            </li>
          ))}
          <li>
            <a
              href={clearFiltersUrl}
              class="text-sm font-semibold text-gray-600 underline hover:text-gray-900"
              data-testid="clear-filters-link"
            >
              Clear Filters
            </a>
          </li>
        </ul>
      )}
    </form>

    <!-- Results count -->
    {!resultsFailed && count !== null && count > 0 && (
      <p class="mb-4 text-gray-600">Found {count} newsletter{count !== 1 ? 's' : ''}</p>
    )}

    {timelineQuery && (
      <SearchTimeline
        query={timelineQuery}
        range={timelineRange}
        selectedMonth={timelineSelectedMonth}
        allMonthsUrl={timelineSelectedMonth ? buildSearchUrlWithoutDates(Astro.url) : null}
        hasOtherFilters={timelineHasOtherFilters}
      />
    )}

    {resultsFailed ? (
      <StatusMessage title={LOAD_FAILED_TITLE} message={LOAD_FAILED_MESSAGE} alert testId="search-load-error" />
    ) : count === 0 ? (
      <StatusMessage
        title="No newsletters match your search"
        message="Try fewer or different words, a wider date range, or fewer filters."
        testId="search-empty"
      />
    ) : newsletters?.length === 0 ? (
      <StatusMessage
        title={PAGE_OUT_OF_RANGE_TITLE}
        message={PAGE_OUT_OF_RANGE_MESSAGE}
        links={[{ label: 'Go to the first page', href: baseUrl }]}
        testId="search-page-empty"
      />
    ) : (
      <div class="space-y-4">
        {newsletters?.map((newsletter) => (
          <NewsletterCard newsletter={newsletter} />
        ))}
      </div>
    )}

    {!resultsFailed && <Pagination currentPage={page} totalPages={totalPages} baseUrl={baseUrl} />}

  </div>
</Layout>
