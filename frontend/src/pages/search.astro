---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import NewsletterCard from '../components/NewsletterCard.astro';
import Pagination from '../components/Pagination.astro';
import SearchTimeline from '../components/SearchTimeline.astro';
import { supabase } from '../lib/supabase';
import { UNCACHEABLE_PAGE_CACHE_CONTROL } from '../lib/server/page-cache';
import { buildNewsletterCardSelect, buildNewsletterCountSelect } from '../lib/server/newsletter-queries';
import type { NewsletterCardRow } from '../lib/server/newsletter-queries';
import { TOPIC_CATEGORIES } from '../lib/topics';
import { humanizeIdentifier } from '../lib/format';
import {
  SEARCH_PAGE_SIZE,
  SEARCH_PARAM_NAMES,
  SEARCH_PATH,
  SEARCH_SORTS,
  SEARCH_SORT_LABELS,
  applySearchFilters,
  applySearchSort,
  buildSearchBaseUrl,
  getPageRange,
  parseSearchParams,
  requiresSourceJoin,
} from '../lib/search-filters';
import {
  SEARCH_SOURCE_COLUMNS,
  buildSourceOptions,
  extractSourceTypes,
  extractWardNumbers,
} from '../lib/server/search-form-options';
import type { SearchSourceRow } from '../lib/server/search-form-options';
import {
  buildSearchUrlWithoutDates,
  normalizeTimelineQuery,
  selectedTimelineMonth,
  timelineRangeForSearch,
} from '../lib/search-timeline';

const { filters, sort, page } = parseSearchParams(Astro.url.searchParams);
const filtersOnSource = requiresSourceJoin(filters);
const { start, end } = getPageRange(page);

const unfilteredCountQuery = supabase
  .from('newsletters')
  .select(buildNewsletterCountSelect({ filtersOnSource }), { count: 'exact', head: true });
const countQuery = applySearchFilters(unfilteredCountQuery, filters);

const unfilteredDataQuery = supabase
  .from('newsletters')
  .select(buildNewsletterCardSelect({ filtersOnSource }));
const filteredDataQuery = applySearchFilters(unfilteredDataQuery, filters);
const dataQuery = applySearchSort(filteredDataQuery, sort);

const sourcesQuery = supabase
  .from('sources')
  .select(SEARCH_SOURCE_COLUMNS.join(', '))
  .overrideTypes<SearchSourceRow[], { merge: false }>();

const [
  { count, error: countError },
  { data, error: dataError },
  { data: sourceData, error: sourcesError },
] = await Promise.all([countQuery, dataQuery.range(start, end), sourcesQuery]);

if (countError || dataError || sourcesError) {
  console.error('Error loading search results:', countError ?? dataError ?? sourcesError);
  // Keep a failed load out of the edge page cache.
  Astro.response.headers.set('Cache-Control', UNCACHEABLE_PAGE_CACHE_CONTROL);
}

const totalPages = Math.ceil((count || 0) / SEARCH_PAGE_SIZE);
const newsletters = data as NewsletterCardRow[] | null;

const sources = sourceData ?? [];
const sourceOptions = buildSourceOptions(sources);
const wardNumbers = extractWardNumbers(sources);
const sourceTypes = extractSourceTypes(sources);
const showSourceTypeFilter = sourceTypes.length > 1;

const baseUrl = buildSearchBaseUrl(filters, sort);
const timelineQuery = (count ?? 0) > 0 ? normalizeTimelineQuery(filters.query) : null;
const timelineRange = timelineRangeForSearch(filters.fromDate, filters.toDate);
const timelineSelectedMonth = selectedTimelineMonth(filters.fromDate, filters.toDate);
const timelineHasOtherFilters = Boolean(
  filters.ward || filters.sourceId || filters.sourceType || filters.topic,
);

const inputClass =
  'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
const labelClass = 'block text-sm font-semibold text-gray-700 mb-2';
---

<Layout
  title="Search - Chicago Alderman Newsletter Tracker"
  description="Search Chicago alderman newsletters by keyword, ward, alderman, and topic."
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Header -->
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">
        Search Newsletters
      </h1>
      <p class="text-base sm:text-lg text-gray-600">
        Filter and search through Chicago alderman newsletters
      </p>
    </header>


    <form method="get" class="bg-white rounded-lg shadow-md p-6 mb-8 border border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
        <div class="md:col-span-2">
          <label for="search-query" class={labelClass}>Search Keywords</label>
          <input
            id="search-query"
            type="text"
            name={SEARCH_PARAM_NAMES.query}
            value={filters.query}
            placeholder="Enter keywords..."
            class={inputClass}
            data-testid="search-input"
          />
        </div>

        <div>
          <label for="search-topic" class={labelClass}>Topic</label>
          <select id="search-topic" name={SEARCH_PARAM_NAMES.topic} class={inputClass} data-testid="topic-filter">
            <option value="">All Topics</option>
            {Object.entries(TOPIC_CATEGORIES).map(([category, topics]) => (
              <optgroup label={category}>
                {topics.map((topic) => (
                  <option value={topic} selected={filters.topic === topic}>
                    {humanizeIdentifier(topic)}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>

        <div>
          <label for="search-sort" class={labelClass}>Sort By</label>
          <select id="search-sort" name={SEARCH_PARAM_NAMES.sort} class={inputClass} data-testid="sort-select">
            {SEARCH_SORTS.map((sortOption) => (
              <option value={sortOption} selected={sort === sortOption}>
                {SEARCH_SORT_LABELS[sortOption]}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6 pt-4 border-t border-gray-100">
        <div class="sm:col-span-2">
          <label for="search-source" class={labelClass}>Alderman / Source</label>
          <select id="search-source" name={SEARCH_PARAM_NAMES.sourceId} class={inputClass} data-testid="source-filter">
            <option value="">All Sources</option>
            {sourceOptions.map((sourceOption) => (
              <option value={sourceOption.id} selected={filters.sourceId === sourceOption.id}>
                {sourceOption.label}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="search-ward" class={labelClass}>Ward Number</label>
          <select id="search-ward" name={SEARCH_PARAM_NAMES.ward} class={inputClass} data-testid="ward-filter">
            <option value="">All Wards</option>
            {wardNumbers.map((ward) => (
              <option value={ward} selected={filters.ward === ward}>
                Ward {ward}
              </option>
            ))}
          </select>
        </div>

        {showSourceTypeFilter && (
          <div>
            <label for="search-source-type" class={labelClass}>Source Type</label>
            <select id="search-source-type" name={SEARCH_PARAM_NAMES.sourceType} class={inputClass} data-testid="source-type-filter">
              <option value="">All Types</option>
              {sourceTypes.map((sourceType) => (
                <option value={sourceType} selected={filters.sourceType === sourceType}>
                  {humanizeIdentifier(sourceType)}
                </option>
              ))}
            </select>
          </div>
        )}

        <div>
          <label for="search-from-date" class={labelClass}>Received From</label>
          <input
            id="search-from-date"
            type="date"
            name={SEARCH_PARAM_NAMES.fromDate}
            value={filters.fromDate ?? ''}
            class={inputClass}
            data-testid="from-date-filter"
          />
        </div>

        <div>
          <label for="search-to-date" class={labelClass}>Received To</label>
          <input
            id="search-to-date"
            type="date"
            name={SEARCH_PARAM_NAMES.toDate}
            value={filters.toDate ?? ''}
            class={inputClass}
            data-testid="to-date-filter"
          />
        </div>
      </div>

      <div class="flex gap-3">
        <button
          type="submit"
          class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm"
          data-testid="search-button"
        >
          Search
        </button>

        <a
          href={SEARCH_PATH}
          class="px-6 py-3 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors"
          data-testid="clear-filters-link"
        >
          Clear Filters
        </a>
      </div>
    </form>

    <!-- Results count -->
    <div class="mb-4 text-gray-600">
      {newsletters?.length === 0 ? (
        <p>No newsletters found matching your criteria.</p>
      ) : count !== null && (
        <p>Found {count} newsletter{count !== 1 ? 's' : ''}</p>
      )}
    </div>

    {timelineQuery && (
      <SearchTimeline
        query={timelineQuery}
        range={timelineRange}
        selectedMonth={timelineSelectedMonth}
        allMonthsUrl={timelineSelectedMonth ? buildSearchUrlWithoutDates(Astro.url) : null}
        hasOtherFilters={timelineHasOtherFilters}
      />
    )}

    <div class="space-y-4">
      {newsletters?.map((newsletter) => (
        <NewsletterCard newsletter={newsletter} />
      ))}
    </div>

    <!-- Pagination -->
    <Pagination currentPage={page} totalPages={totalPages} baseUrl={baseUrl} />

  </div>
</Layout>