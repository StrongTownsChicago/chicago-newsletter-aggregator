---
// One prerendered page per report in the committed src/data/monthly-reports.json:
// static HTML with no database query and no server code.
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import reportsData from '../../data/monthly-reports.json';
import ReportFootnote from '../../components/reports/ReportFootnote.astro';
import { formatLongDate, formatLongMonth } from '../../lib/archive-months';
import {
  buildReportDescription,
  buildReportHeading,
  buildReportPath,
  buildReportTitle,
  describeRisingTerm,
  describeSendingWards,
  findAdjacentReports,
  isReportMonth,
  topicLabel,
  topicReachFraction,
  type MonthlyReport,
  type MonthlyReportsFile,
} from '../../lib/monthly-reports';
import { REPORTS_INDEX_PATH } from '../../lib/site';
import { buildWardPath } from '../../lib/wards';

export const getStaticPaths = (() => {
  const file = reportsData as MonthlyReportsFile;
  return file.reports
    .filter((report) => isReportMonth(report.month))
    .map((report) => ({ params: { month: report.month }, props: { report } }));
}) satisfies GetStaticPaths;

interface Props {
  report: MonthlyReport;
}

const { report } = Astro.props;
const file = reportsData as MonthlyReportsFile;
const monthLabel = formatLongMonth(report.month);
const { newer, older } = findAdjacentReports(file.reports, report.month);
const linkClass = 'text-blue-600 hover:text-blue-800 hover:underline';
---

<Layout
  title={buildReportTitle(report.month)}
  description={buildReportDescription(report, file.topics)}
  type="article"
>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <p class="text-sm mb-3">
      <a href={REPORTS_INDEX_PATH} class={linkClass} data-testid="report-index-link">← All monthly reports</a>
    </p>

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">{buildReportHeading(report.month)}</h1>
      <p class="text-base sm:text-lg text-gray-700" data-testid="report-summary">
        Based on {report.newsletters} newsletters in the archive from {describeSendingWards(report)} in {monthLabel}.
      </p>
    </header>

    <section class="mb-10" aria-labelledby="report-topics-heading" data-testid="report-topics">
      <h2 id="report-topics-heading" class="text-2xl font-bold text-gray-900 mb-1">Topics by how many wards mentioned them</h2>
      <p class="text-sm text-gray-600 mb-4">
        How many of the {report.readable_wards} wards analyzed for {monthLabel} had a newsletter mentioning each topic, with a few example newsletters.
      </p>
      <ol class="space-y-4">
        {report.topics.map((topic) => (
          <li class="bg-white rounded-lg shadow-sm border border-gray-200 p-4" data-testid="report-topic">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <h3 class="font-semibold text-gray-900">{topicLabel(file.topics, topic.id)}</h3>
              <p class="text-sm text-gray-700">
                <strong>{topic.wards} of {report.readable_wards} wards</strong> · {topic.newsletters} newsletter{topic.newsletters === 1 ? '' : 's'}
              </p>
            </div>
            <div class="mt-2 h-2 rounded-full bg-gray-100" aria-hidden="true">
              <div class="h-2 rounded-full bg-blue-600" style={`width: ${(topicReachFraction(topic, report) * 100).toFixed(1)}%`}></div>
            </div>
            {topic.examples.length > 0 && (
              <ul class="mt-3 space-y-1 text-sm" aria-label={`Example newsletters: ${topicLabel(file.topics, topic.id)}`}>
                {topic.examples.map((example) => (
                  <li class="min-w-0">
                    <a href={`/newsletter/${example.id}`} class={`${linkClass} break-words`}>
                      {example.subject || 'Untitled newsletter'}
                    </a>
                    <span class="text-gray-500">
                      {example.ward && <> · Ward {example.ward}</>} · <time datetime={example.date}>{formatLongDate(example.date)}</time>
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>

    {report.rising && report.rising.terms.length > 0 && (
      <section class="mb-10" aria-labelledby="report-rising-heading" data-testid="report-rising">
        <h2 id="report-rising-heading" class="text-2xl font-bold text-gray-900 mb-1">Terms more wards used than usual</h2>
        <p class="text-sm text-gray-600 mb-4">
          Wards whose newsletters used each term in {monthLabel}, compared with a typical month from
          {' '}{formatLongMonth(report.rising.baseline_months[0])} to {formatLongMonth(report.rising.baseline_months[report.rising.baseline_months.length - 1])}.
        </p>
        <ul class="grid gap-2 sm:grid-cols-2">
          {report.rising.terms.map((term) => (
            <li class="bg-white rounded-lg border border-gray-200 px-4 py-2">
              <span class="font-medium text-gray-900">{term.term}</span>
              <span class="block text-sm text-gray-600">{describeRisingTerm(term)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mb-10" aria-labelledby="report-coverage-heading" data-testid="report-coverage">
      <h2 id="report-coverage-heading" class="text-2xl font-bold text-gray-900 mb-2">Coverage</h2>
      <p class="text-gray-700 mb-3">
        The archive has newsletters from {describeSendingWards(report)} in {monthLabel}:
      </p>
      <ul class="flex flex-wrap gap-2 mb-4" aria-label="Wards with newsletters in the archive">
        {report.sending_wards.map((ward) => (
          <li>
            <a href={buildWardPath(ward)} class="inline-block px-2 py-0.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-full text-sm font-medium">
              Ward {ward}
            </a>
          </li>
        ))}
      </ul>
      {report.absent_wards.length > 0 && (
        <p class="text-gray-700" data-testid="report-absent-wards">
          No newsletters from these wards are in the archive for {monthLabel}:
          {' '}{report.absent_wards.map((ward, index) => (
            <>{index > 0 && ', '}<a href={buildWardPath(ward)} class={linkClass}>{ward}</a></>
          ))}.
          {' '}The ward's office may not have sent one, or it may not have reached the archive.
        </p>
      )}
    </section>

    <nav class="flex flex-wrap justify-between gap-4 text-sm" aria-label="Other monthly reports">
      {older ? <a href={buildReportPath(older.month)} class={linkClass}>← {formatLongMonth(older.month)}</a> : <span></span>}
      <a href={REPORTS_INDEX_PATH} class={linkClass}>All monthly reports</a>
      {newer ? <a href={buildReportPath(newer.month)} class={linkClass}>{formatLongMonth(newer.month)} →</a> : <span></span>}
    </nav>

    <ReportFootnote dataThrough={file.data_through} />
  </div>
</Layout>
