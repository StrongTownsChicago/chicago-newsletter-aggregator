---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import NewsletterCard from '../../components/NewsletterCard.astro';
import Pagination from '../../components/Pagination.astro';
import WardGlance from '../../components/WardGlance.astro';
import WardGlanceSummary from '../../components/WardGlanceSummary.astro';
import NotFound from '../../components/NotFound.astro';
import StatusMessage from '../../components/StatusMessage.astro';
import {
  LOAD_FAILED_MESSAGE,
  LOAD_FAILED_TITLE,
  PAGE_OUT_OF_RANGE_MESSAGE,
  PAGE_OUT_OF_RANGE_TITLE,
} from '../../lib/load-messages';
import { supabase } from '../../lib/supabase';
import { UNCACHEABLE_PAGE_CACHE_CONTROL } from '../../lib/server/page-cache';
import type { WardProfileSource } from '../../lib/server/newsletter-queries';
import { countPages, parsePageParam } from '../../lib/pagination';
import {
  SITE_NAME,
  buildWardDescription,
  buildWardStructuredData,
  buildWardTitle,
  formatReceivedDate,
  serializeJsonLd,
} from '../../lib/seo';
import {
  EMPTY_WARD_NEWSLETTER_PAGE,
  fetchWardNewsletterPage,
  fetchWardSources,
  type WardNewsletterPage,
} from '../../lib/server/ward-queries';
import {
  CITY_WARD_LOOKUP_URL,
  buildWardContactLinks,
  buildWardPath,
  buildWardSearchPath,
  formatWardAldermanHeading,
  formatWardName,
  parseWardParam,
} from '../../lib/wards';

const wardNumber = parseWardParam(Astro.params.ward);
const page = parsePageParam(Astro.url.searchParams.get('page'));

let sources: WardProfileSource[] = [];
let newsletterPage: WardNewsletterPage = EMPTY_WARD_NEWSLETTER_PAGE;
let loadFailed = false;

if (wardNumber === null) {
  Astro.response.status = 404;
} else {
  try {
    sources = await fetchWardSources(supabase, wardNumber);
    newsletterPage = await fetchWardNewsletterPage(
      supabase,
      sources.map((source) => source.id),
      page,
    );
  } catch (error) {
    console.error(`Error loading ward ${wardNumber}:`, error);
    loadFailed = true;
    Astro.response.status = 503;
    // Keep a failed load out of the edge page cache.
    Astro.response.headers.set('Cache-Control', UNCACHEABLE_PAGE_CACHE_CONTROL);
  }
}

const alderNames = sources.map((source) => source.name);
const { newsletters, totalCount, latestReceivedDate } = newsletterPage;
// Listings are newest first, so page 1 starts with the ward's latest newsletter.
const latestNewsletter = page === 1 ? (newsletters[0] ?? null) : null;
const totalPages = countPages(totalCount);
const latestDateLabel = latestReceivedDate ? formatReceivedDate(latestReceivedDate) : null;

const title = wardNumber === null
  ? `Ward not found - ${SITE_NAME}`
  : buildWardTitle(wardNumber, alderNames);
const description = wardNumber === null
  ? 'Chicago has 50 wards. Browse the ward directory to find newsletters from your alderman.'
  : buildWardDescription(wardNumber, alderNames, latestNewsletter);
const structuredData = wardNumber === null || loadFailed
  ? null
  : buildWardStructuredData(wardNumber, sources, Astro.site ?? Astro.url.origin);
const wardName = wardNumber === null ? null : formatWardName(wardNumber);
---

<Layout title={title} description={description} canonicalPage={page}>
  {structuredData && (
    /* eslint-disable-next-line astro/no-set-html-directive -- JSON-LD built from our own data; serializeJsonLd escapes "<" */
    <script slot="head" type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
  )}
  {wardNumber === null ? (
    <NotFound
      title="Ward not found"
      message="Chicago has 50 wards, numbered 1 through 50."
      testId="ward-not-found"
    />
  ) : (
  <div class="container mx-auto px-4 py-8 max-w-6xl">
        <!-- Ward Header -->
        <header class="mb-8 bg-white rounded-lg shadow-sm border border-gray-200 p-6" data-testid="ward-header">
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4" data-testid="ward-title">
            {formatWardAldermanHeading(wardNumber, alderNames)}
          </h1>

          {sources.length > 0 && (
            <div class="space-y-3">
              {sources.map((source) => {
                const contactLinks = buildWardContactLinks(source);
                return (
                  <div data-testid="ward-alder">
                    {sources.length > 1 && (
                      <p class="font-medium text-gray-800 mb-1">{source.name}</p>
                    )}
                    {contactLinks.length > 0 && (
                      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm" data-testid="ward-contact-links">
                        {contactLinks.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class="text-blue-600 hover:text-blue-800 hover:underline break-all"
                              {...(link.isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                              data-testid={`ward-contact-${link.kind}`}
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                );
              })}
            </div>
          )}

          {!loadFailed && sources.length === 0 && (
            <p class="text-gray-600" data-testid="ward-no-alder">
              We don't have an alderman on file for this ward yet.
            </p>
          )}

          {totalCount > 0 && (
            <>
              <p class="mt-4 text-sm text-gray-600" data-testid="ward-stats">
                {totalCount} newsletter{totalCount !== 1 ? 's' : ''}
                {latestDateLabel && <> · Latest {latestDateLabel}</>}
              </p>
              {page === 1 && <WardGlanceSummary wardNumber={wardNumber} />}
              <a
                href={buildWardSearchPath(wardNumber)}
                class="inline-block mt-4 text-sm font-medium text-blue-600 hover:text-blue-800"
                data-testid="ward-search-link"
              >
                Search and filter {wardName} newsletters →
              </a>
            </>
          )}

          <p class="mt-4 text-sm text-gray-600" data-testid="ward-lookup">
            Not sure this is your ward?
            <a
              href={CITY_WARD_LOOKUP_URL}
              class="text-blue-600 underline hover:text-blue-800"
              target="_blank"
              rel="noopener noreferrer"
            >Look up your address</a>
          </p>
        </header>

        <!-- Newsletter List -->
        <section>
          {loadFailed ? (
            <StatusMessage title={LOAD_FAILED_TITLE} message={LOAD_FAILED_MESSAGE} alert testId="ward-load-error" />
          ) : totalCount === 0 ? (
            <StatusMessage
              title={`No newsletters from the ${wardName} yet`}
              message="Newsletters will appear here once we archive one from this ward."
              testId="ward-empty"
            />
          ) : (
            <>
              <div class="space-y-4">
                {newsletters.length === 0 && (
                  <StatusMessage
                    title={PAGE_OUT_OF_RANGE_TITLE}
                    message={PAGE_OUT_OF_RANGE_MESSAGE}
                    links={[{ label: 'Go to the newest newsletters', href: buildWardPath(wardNumber) }]}
                    testId="ward-page-empty"
                  />
                )}
                {newsletters.map((newsletter) => (
                  <NewsletterCard newsletter={newsletter} />
                ))}
              </div>
              <Pagination currentPage={page} totalPages={totalPages} baseUrl={buildWardPath(wardNumber)} />
            </>
          )}
        </section>

        {page === 1 && <WardGlance wardNumber={wardNumber} />}
  </div>
  )}
</Layout>
