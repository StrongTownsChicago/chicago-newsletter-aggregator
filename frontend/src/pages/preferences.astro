---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import RuleList from '../components/preferences/RuleList.astro';
import RuleModal from '../components/preferences/RuleModal.astro';
import { notificationsEnabled } from '../lib/supabase';
import type { UserProfile, NotificationRule } from '../lib/supabase';
import { shouldShowWelcome } from '../lib/onboarding';

// Redirect if notifications are disabled
if (!notificationsEnabled()) {
  return Astro.redirect('/');
}

const user = Astro.locals.user;

// Protect this route - require authentication
if (!user) {
  const returnPath = `${Astro.url.pathname}${Astro.url.search}`;
  return Astro.redirect(`/login?next=${encodeURIComponent(returnPath)}`);
}

const supabase = Astro.locals.supabase;

// Fetch user profile
const { data: profile, error: profileErr } = await supabase
  .from('user_profiles')
  .select('*')
  .eq('id', user.id)
  .single();

if (profileErr) {
  return Astro.redirect(`/?error=${encodeURIComponent(profileErr.message)}`);
}

// Fetch notification rules
const { data: rules, error: rulesErr } = await supabase
  .from('notification_rules')
  .select('*')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false });

if (rulesErr) {
  return Astro.redirect(`/?error=${encodeURIComponent(rulesErr.message)}`);
}

// Fetch distinct wards for filtering options
const { data: sources, error: sourcesErr } = await supabase
  .from('sources')
  .select('ward_number')
  .not('ward_number', 'is', null)
  .order('ward_number');

if (sourcesErr) {
    console.error('Error fetching sources:', sourcesErr);
}

// Unique sorted wards
const availableWards = Array.from(new Set(
  (sources || [])
    .map(s => s.ward_number)
    .filter(w => w) // Filter out empty strings
    .sort((a, b) => parseInt(a as string) - parseInt(b as string))
));

const userProfile = profile as UserProfile | null;
const notificationRules = (rules as NotificationRule[]) || [];

const maxRules = 5;
const canCreateRule = notificationRules.length < maxRules;

const error = Astro.url.searchParams.get('error');
const message = Astro.url.searchParams.get('message');

// First visit after signup: explain that alerts require a rule and pre-open the rule modal
const isWelcome = shouldShowWelcome(Astro.url.searchParams, notificationRules.length);
---

<Layout
  title="Notification Preferences - Chicago Alderman Newsletter Tracker"
  description="Manage your email alerts for Chicago alderman newsletters."
>
  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">
            Notification Preferences
          </h1>
          <p class="text-base text-gray-600">
            Manage your notification rules and email preferences
          </p>
        </div>
      </div>
    </header>


    {isWelcome && (
      <div data-testid="welcome-banner" class="mb-6 bg-blue-50 border border-blue-200 text-blue-900 px-5 py-4 rounded-lg">
        <h2 class="text-lg font-semibold mb-1">Welcome! One more step to start getting emails</h2>
        <p class="text-sm text-blue-800">
          You'll only receive emails once you create an alert. Pick the topics you care about for a weekly
          summary, or switch to a daily digest. You can change it anytime.
        </p>
      </div>
    )}

    {error && (
      <div class="mb-6 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm flex items-start gap-2">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <span>{error}</span>
      </div>
    )}

    {message && (
      <div class="mb-6 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg text-sm flex items-start gap-2">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>{message}</span>
      </div>
    )}

    <!-- Global Settings -->
    <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-6 sm:p-8 mb-6">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Global Settings</h2>
      </div>

      <form action="/api/notifications/update-preferences" method="POST" enctype="application/x-www-form-urlencoded" class="space-y-6">
        <div class="bg-gray-50 rounded-lg p-5 border border-gray-100">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <label for="enabled" class="text-base font-semibold text-gray-900 block mb-1">
                Enable Email Notifications
              </label>
              <p class="text-sm text-gray-600">
                Receive digest emails when newsletters match your rules
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
              <input
                type="checkbox"
                id="enabled"
                name="enabled"
                checked={userProfile?.notification_preferences?.enabled ?? true}
                class="sr-only peer"
              />
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
            </label>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold py-2.5 px-6 rounded-lg transition-colors shadow-sm"
          >
            Save Preferences
          </button>
          <span class="text-sm text-gray-500">Changes take effect immediately</span>
        </div>
      </form>
    </div>

    <RuleList notificationRules={notificationRules} maxRules={maxRules} canCreateRule={canCreateRule} />
  </div>

  <RuleModal isWelcome={isWelcome} availableWards={availableWards} />

  <script>
    import { initRuleModal } from '../scripts/rule-modal';

    initRuleModal();
  </script>
</Layout>
