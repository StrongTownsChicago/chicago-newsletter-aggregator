---
export const prerender = false;

// Local-only exploration dashboard. Data comes from gitignored JSON files
// generated by `uv run python -m utils.compute_analytics`; on a clean checkout
// (including production) the page renders setup instructions instead.
import Layout from '../layouts/Layout.astro';
import AnalyticsPanel from '../components/analytics/AnalyticsPanel.astro';
import { findMissingAnalyticsFiles, loadAnalyticsMetadata } from '../lib/analytics-data';
import { humanizeIdentifier } from '../lib/format';
import { ALL_TOPICS } from '../lib/topics';
import { MIN_MONTH_NEWSLETTERS_FOR_SHARES } from '../lib/analytics';

// Local exploration only: keep it out of search indexes (Layout has no noindex option).
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const missingFiles = findMissingAnalyticsFiles();
const metadata = missingFiles.length === 0 ? await loadAnalyticsMetadata() : null;
const RELEVANCE_LEVELS = Array.from({ length: 10 }, (_, index) => index + 1);
const controlClass =
  'w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
---

<Layout
  title="Analytics - Chicago Alderman Newsletter Tracker"
  description="Local analytics dashboard exploring topics, vocabulary, and sending patterns across alderman newsletters."
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <header class="mb-6">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Newsletter Analytics</h1>
      <p class="text-base sm:text-lg text-gray-600">
        What aldermen talk about, how often, and how it differs across the city.
      </p>
      {metadata && (
        <p class="text-sm text-gray-500 mt-2">
          Data generated {new Date(metadata.generated_at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}
          from {metadata.newsletter_count.toLocaleString()} newsletters ({metadata.first_date} to {metadata.last_date}).
        </p>
      )}
    </header>

    {missingFiles.length > 0 ? (
      <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200" data-testid="analytics-no-data">
        <h2 class="text-xl font-bold text-gray-900 mb-2">No analytics data yet</h2>
        <p class="text-gray-700 mb-3">
          This dashboard reads locally generated files that are not committed to the repository.
          Generate them from the <code>backend/</code> directory, then reload this page:
        </p>
        <pre class="bg-gray-100 rounded p-3 text-sm overflow-x-auto"><code>uv run python -m utils.compute_analytics</code></pre>
        <p class="text-sm text-gray-500 mt-3">Missing in <code>frontend/src/data/analytics/</code>: {missingFiles.join(', ')}</p>
      </div>
    ) : (
      <div id="analytics-dashboard" class="space-y-6">
        <form id="analytics-filters" class="bg-white rounded-lg shadow-md p-4 sm:p-6 border border-gray-200" aria-label="Dashboard filters">
          <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="col-span-2 lg:col-span-1">
              <span class="block text-sm font-semibold text-gray-700 mb-2">Wards</span>
              <details class="relative" id="ward-picker">
                <summary class={`${controlClass} cursor-pointer list-none`} id="ward-summary">All wards</summary>
                <div class="absolute z-20 mt-1 w-64 max-h-72 overflow-y-auto bg-white border border-gray-200 rounded-lg shadow-lg p-2">
                  <button type="button" id="clear-wards" class="w-full text-left text-sm text-blue-600 hover:bg-gray-50 rounded px-2 py-1 mb-1">All wards</button>
                  <div id="ward-options" class="grid grid-cols-3 gap-1"></div>
                </div>
              </details>
            </div>
            <label class="col-span-2 lg:col-span-1 block">
              <span class="block text-sm font-semibold text-gray-700 mb-2">Topic</span>
              <select name="topic" class={controlClass}>
                <option value="">All topics</option>
                {ALL_TOPICS.map((topic) => <option value={topic}>{humanizeIdentifier(topic)}</option>)}
              </select>
            </label>
            <label class="block">
              <span class="block text-sm font-semibold text-gray-700 mb-2">From</span>
              <select name="from" class={controlClass}><option value="">Start</option></select>
            </label>
            <label class="block">
              <span class="block text-sm font-semibold text-gray-700 mb-2">To</span>
              <select name="to" class={controlClass}><option value="">Latest</option></select>
            </label>
            <label class="col-span-2 lg:col-span-1 block">
              <span class="block text-sm font-semibold text-gray-700 mb-2">Minimum relevance</span>
              <select name="relevance" class={controlClass}>
                <option value="0">Any</option>
                {RELEVANCE_LEVELS.map((level) => <option value={level}>{level}+</option>)}
              </select>
            </label>
          </div>
          <div class="mt-4 flex justify-end">
            <button type="reset" class="px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors text-sm">
              Reset filters
            </button>
          </div>
        </form>

        <div id="summary-tiles" class="grid grid-cols-2 lg:grid-cols-4 gap-4" aria-live="polite">
          {['Newsletters', 'Active alders', 'Date span', 'Average relevance'].map((label) => (
            <div class="bg-white rounded-lg shadow-md p-4 border border-gray-200">
              <p class="text-sm text-gray-600">{label}</p>
              <p class="text-xl sm:text-2xl font-semibold text-gray-900 mt-1" data-tile-value></p>
              <p class="text-xs text-gray-500 mt-1" data-tile-detail></p>
            </div>
          ))}
        </div>

        <AnalyticsPanel
          id="term-explorer"
          title="Term explorer"
          description={`Search a word or two-word phrase to see how often newsletters mention it over time and which wards use it most. Respects the ward and date filters (terms are not indexed by topic or relevance). Months with fewer than ${MIN_MONTH_NEWSLETTERS_FOR_SHARES} newsletters are left blank.`}
        >
          <form id="term-form" class="flex gap-2 mb-2" role="search">
            <label for="term-input" class="sr-only">Term</label>
            <input id="term-input" type="search" autocomplete="off" placeholder="e.g. bike lanes, zoning, budget" class={controlClass} />
            <button type="submit" class="px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">Explore</button>
          </form>
          <div id="term-suggestions" class="flex flex-wrap gap-2 mb-3"></div>
          <p id="term-message" class="text-sm text-gray-700 mb-3" aria-live="polite"></p>
          <div id="term-timeline" class="overflow-x-auto"></div>
          <h3 id="term-wards-title" class="text-sm font-semibold text-gray-700 mt-4 mb-2 hidden">Top wards using this term</h3>
          <div id="term-wards" class="overflow-x-auto"></div>
        </AnalyticsPanel>

        <AnalyticsPanel
          id="ward-topic-heatmap"
          title="Ward × topic focus"
          description="Each ward's share of newsletters mentioning a topic compared with the city-wide share for the same filters. Blue means the ward discusses it more than average, red less. Click a cell to see those newsletters. Ignores the topic filter (the selected topic is outlined)."
        >
          <div data-chart class="overflow-x-auto"></div>
        </AnalyticsPanel>

        <AnalyticsPanel
          id="topic-trends"
          title="Topic trends"
          description={`Share of LLM-processed newsletters mentioning each topic, by month, on a shared vertical scale. Months with fewer than ${MIN_MONTH_NEWSLETTERS_FOR_SHARES} newsletters are left blank.`}
        >
          <div data-chart class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4"></div>
        </AnalyticsPanel>

        <AnalyticsPanel
          id="distinctive-terms"
          title="Distinctive vocabulary"
          description="Words and phrases a ward uses far more than the rest of the city (computed over all dates; the alder's own name and footer boilerplate are excluded). Click a bar to search."
        >
          <label class="block mb-3 max-w-xs">
            <span class="block text-sm font-semibold text-gray-700 mb-2">Ward</span>
            <select id="distinctive-ward" class={controlClass}></select>
          </label>
          <div data-chart class="overflow-x-auto"></div>
        </AnalyticsPanel>

        <AnalyticsPanel
          id="rising-terms"
          title="Rising terms"
          description="Terms whose share of newsletters rose most in the latest complete month versus the previous six months. Computed city-wide; requires mentions from several sources."
        >
          <div data-chart class="overflow-x-auto"></div>
        </AnalyticsPanel>

        <AnalyticsPanel
          id="sending-cadence"
          title="Sending cadence"
          description="Newsletters per ward per month (blank = none received), followed by the longest gaps between consecutive newsletters from the same source."
        >
          <div data-chart class="overflow-x-auto"></div>
          <h3 class="text-sm font-semibold text-gray-700 mt-4 mb-2">Longest gaps</h3>
          <div id="cadence-gaps" class="overflow-x-auto"></div>
        </AnalyticsPanel>

        <AnalyticsPanel
          id="relevance-by-ward"
          title="Relevance score by ward"
          description="Average LLM relevance score (0-10, relevance to Strong Towns Chicago priorities) per ward, with the number of scored newsletters."
        >
          <div data-chart class="overflow-x-auto"></div>
        </AnalyticsPanel>

        <AnalyticsPanel
          id="coverage"
          title="Data coverage"
          description="When each source's newsletters begin and end in the archive, with total counts. Sources that joined later have fewer newsletters, so compare wards with this in mind. Respects the ward filter only."
        >
          <div data-chart class="overflow-x-auto"></div>
        </AnalyticsPanel>
      </div>
    )}
  </div>
</Layout>

<script>
  // Load the charting bundle only when there is data to chart.
  if (document.getElementById('analytics-dashboard')) {
    import('../scripts/analytics-dashboard').then(({ startAnalyticsDashboard }) => startAnalyticsDashboard());
  }
</script>
