---
export const prerender = false;

// Unlisted exploration dashboard. The page itself carries no data: the browser
// fetches the committed JSON in public/analytics-data/ at runtime (see
// lib/analytics-data.ts), so nothing is bundled into the server or client code.
// It stays server-rendered like the rest of the site so the header reflects the
// signed-in user.
import Layout from '../layouts/Layout.astro';
import AnalyticsPanel from '../components/analytics/AnalyticsPanel.astro';
import { humanizeIdentifier } from '../lib/format';
import { ALL_TOPICS } from '../lib/topics';
import { formatMonth, MIN_MONTH_NEWSLETTERS_FOR_SHARES, STREET_SAFETY_LABELING_START_MONTH } from '../lib/analytics';

// Unlisted: keep it out of search indexes (Layout has no noindex option).
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const controlClass =
  'w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
---

<Layout
  title="Analytics - Chicago Alderman Newsletter Tracker"
  description="Local analytics dashboard exploring topics, vocabulary, and sending patterns across alderman newsletters."
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <header class="mb-6">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Newsletter Analytics</h1>
      <p class="text-base sm:text-lg text-gray-600">
        What aldermen talk about, how often, and how it differs across the city.
      </p>
      <p id="analytics-data-as-of" class="text-sm text-gray-500 mt-2" hidden></p>
    </header>

    <p id="analytics-loading" class="text-gray-600" role="status">Loading analytics data…</p>

    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200" id="analytics-no-data" data-testid="analytics-no-data" hidden>
      <h2 class="text-xl font-bold text-gray-900 mb-2">No analytics data yet</h2>
      <p class="text-gray-700 mb-3">
        This dashboard reads JSON files generated from a local snapshot and committed to
        <code>frontend/public/analytics-data/</code>. Generate them from the <code>backend/</code> directory,
        then reload this page (or commit the folder and push to publish them):
      </p>
      <pre class="bg-gray-100 rounded p-3 text-sm overflow-x-auto"><code>uv run python -m utils.compute_analytics</code></pre>
      <p class="text-sm text-gray-500 mt-3">Missing: <span id="analytics-missing-files"></span></p>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200" id="analytics-load-error" role="alert" hidden>
      <h2 class="text-xl font-bold text-gray-900 mb-2">Could not load analytics data</h2>
      <p class="text-gray-700 mb-3">The data files exist but could not be loaded. Reload the page to try again.</p>
      <p class="text-sm text-gray-500" id="analytics-load-error-detail"></p>
    </div>

    <div id="analytics-dashboard" class="space-y-6" hidden>
      <form id="analytics-filters" class="bg-white rounded-lg shadow-md p-4 sm:p-6 border border-gray-200" aria-label="Dashboard filters">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="col-span-2 lg:col-span-1">
            <span class="block text-sm font-semibold text-gray-700 mb-2">Wards</span>
            <details class="relative" id="ward-picker">
              <summary class={`${controlClass} cursor-pointer list-none`} id="ward-summary">All wards</summary>
              <div class="absolute z-20 mt-1 w-64 max-h-72 overflow-y-auto bg-white border border-gray-200 rounded-lg shadow-lg p-2">
                <button type="button" id="clear-wards" class="w-full text-left text-sm text-blue-600 hover:bg-gray-50 rounded px-2 py-1 mb-1">All wards</button>
                <div id="ward-options" class="grid grid-cols-3 gap-1"></div>
              </div>
            </details>
          </div>
          <label class="col-span-2 lg:col-span-1 block">
            <span class="block text-sm font-semibold text-gray-700 mb-2">Topic</span>
            <select name="topic" class={controlClass}>
              <option value="">All topics</option>
              {ALL_TOPICS.map((topic) => <option value={topic}>{humanizeIdentifier(topic)}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="block text-sm font-semibold text-gray-700 mb-2">From</span>
            <select name="from" class={controlClass}><option value="">Start</option></select>
          </label>
          <label class="block">
            <span class="block text-sm font-semibold text-gray-700 mb-2">To</span>
            <select name="to" class={controlClass}><option value="">Latest</option></select>
          </label>
        </div>
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3">
          <p id="date-window-status" class="text-sm text-gray-700 flex-1" aria-live="polite"></p>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="date-window-toggle" class="px-4 py-2 bg-blue-50 text-blue-700 font-semibold rounded-lg hover:bg-blue-100 transition-colors text-sm"></button>
            <button type="reset" class="px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors text-sm">
              Reset filters
            </button>
          </div>
        </div>
      </form>

      <div id="summary-tiles" class="grid grid-cols-2 lg:grid-cols-4 gap-4" aria-live="polite">
        {['Newsletters', 'Wards with newsletters', 'Date span', 'Data as of'].map((label) => (
          <div class="bg-white rounded-lg shadow-md p-4 border border-gray-200">
            <p class="text-sm text-gray-600">{label}</p>
            <p class="text-xl sm:text-2xl font-semibold text-gray-900 mt-1" data-tile-value></p>
            <p class="text-xs text-gray-500 mt-1" data-tile-detail></p>
          </div>
        ))}
      </div>

      <AnalyticsPanel
        id="coverage"
        title="What the archive covers"
        description="Newsletters per ward per month for the selected wards and dates. Gray means not tracked yet (before the ward's first archived newsletter, or no newsletter ever); outlined means tracked but nothing received that month. Wards with no newsletters are not in the archive, which says nothing about whether their aldermen publish one. The other panels can only reflect newsletters the archive holds, so read them against this grid. Ignores the topic filter."
      >
        <div data-chart class="overflow-x-auto"></div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="term-explorer"
        title="Term explorer"
        description={`Search a word or two-word phrase to see how often newsletters mention it over time and which wards use it most. Respects the ward and date filters (terms are not indexed by topic). Months with fewer than ${MIN_MONTH_NEWSLETTERS_FOR_SHARES} newsletters are left blank.`}
      >
        <form id="term-form" class="flex gap-2 mb-2" role="search">
          <label for="term-input" class="sr-only">Term</label>
          <input id="term-input" type="search" autocomplete="off" placeholder="e.g. bike lanes, zoning, budget" class={controlClass} />
          <button type="submit" class="px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">Explore</button>
        </form>
        <div id="term-suggestions" class="flex flex-wrap gap-2 mb-3"></div>
        <p id="term-message" class="text-sm text-gray-700 mb-3" aria-live="polite"></p>
        <div id="term-timeline" class="overflow-x-auto"></div>
        <h3 id="term-wards-title" class="text-sm font-semibold text-gray-700 mt-4 mb-2 hidden">Top wards using this term</h3>
        <div id="term-wards" class="overflow-x-auto"></div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="topic-trends"
        title="Topic trends"
        description={`Share of LLM-processed newsletters mentioning each topic, by month, on a shared vertical scale. Months with fewer than ${MIN_MONTH_NEWSLETTERS_FOR_SHARES} newsletters are left blank, and topics added to the LLM topic list later start in the first month they were labeled (street safety: ${formatMonth(STREET_SAFETY_LABELING_START_MONTH)}).`}
      >
        <div data-chart class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4"></div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="distinctive-terms"
        title="Distinctive vocabulary"
        description="Words and phrases a ward uses far more than the rest of the city (computed over all dates; the alderman's own name and footer boilerplate are excluded). Click a bar to search."
      >
        <label class="block mb-3 max-w-xs">
          <span class="block text-sm font-semibold text-gray-700 mb-2">Ward</span>
          <select id="distinctive-ward" class={controlClass}></select>
        </label>
        <div data-chart class="overflow-x-auto"></div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="rising-terms"
        title="Rising terms"
        description="Terms whose share of newsletters rose most in the latest complete month versus the previous six months. Computed city-wide; requires mentions from several sources."
      >
        <div data-chart class="overflow-x-auto"></div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="sending-cadence"
        title="Sending cadence"
        description="The longest gaps between consecutive newsletters from the same source in the selected wards and dates (ignores the topic filter). Monthly counts per ward are in the coverage grid at the top of the page. Gaps in scraped archives may reflect what was archived rather than what was sent."
        hasTable={false}
      >
        <div id="cadence-gaps" class="overflow-x-auto"></div>
      </AnalyticsPanel>
    </div>
  </div>
</Layout>

<script>
  import { loadCoreAnalyticsData } from '../lib/analytics-data';
  import { describeDataAsOf } from '../lib/analytics';

  function showSection(id: string): void {
    document.getElementById('analytics-loading')?.setAttribute('hidden', '');
    document.getElementById(id)?.removeAttribute('hidden');
  }

  function setText(id: string, text: string): void {
    const element = document.getElementById(id);
    if (element) element.textContent = text;
  }

  async function startAnalyticsPage(): Promise<void> {
    const result = await loadCoreAnalyticsData();
    if (result.status === 'missing') {
      setText('analytics-missing-files', result.missingFiles.join(', '));
      showSection('analytics-no-data');
      return;
    }
    if (result.status === 'failed') {
      setText('analytics-load-error-detail', result.message);
      showSection('analytics-load-error');
      return;
    }
    setText('analytics-data-as-of', describeDataAsOf(result.data.metadata));
    document.getElementById('analytics-data-as-of')?.removeAttribute('hidden');
    showSection('analytics-dashboard');
    // The charting bundle loads only when there is data to chart.
    const { startAnalyticsDashboard } = await import('../scripts/analytics-dashboard');
    startAnalyticsDashboard(result.data);
  }

  startAnalyticsPage().catch((error: unknown) => {
    setText('analytics-load-error-detail', error instanceof Error ? error.message : String(error));
    showSection('analytics-load-error');
  });
</script>
