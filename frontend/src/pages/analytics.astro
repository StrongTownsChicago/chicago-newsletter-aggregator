---
export const prerender = false;

// The browser fetches the committed JSON in
// public/analytics-data/ at runtime (lib/analytics-data.ts); server-rendered so
// the header reflects the signed-in user.
import Layout from '../layouts/Layout.astro';
import AnalyticsPanel from '../components/analytics/AnalyticsPanel.astro';
import { MIN_MONTH_NEWSLETTERS_FOR_SHARES } from '../lib/analytics';


const controlClass =
  'w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
---

<Layout
  title="Analytics - Chicago Alderman Newsletter Tracker"
  description="What aldermen's newsletters cover, how often they're sent, and how wards differ."
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <header class="mb-6">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Newsletter Analytics</h1>
      <p class="text-base sm:text-lg text-gray-600">
        What aldermen's newsletters cover, how often they're sent, and how wards differ.
      </p>
      <p id="analytics-data-as-of" class="text-sm text-gray-500 mt-2" hidden></p>
    </header>

    <p id="analytics-loading" class="text-gray-600" role="status">Loading analytics data…</p>

    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200" id="analytics-no-data" data-testid="analytics-no-data" hidden>
      <h2 class="text-xl font-bold text-gray-900 mb-2">No analytics data yet</h2>
      <p class="text-gray-700 mb-3">
        Generate <code>frontend/public/analytics-data/</code> from <code>backend/</code>, then reload:
      </p>
      <pre class="bg-gray-100 rounded p-3 text-sm overflow-x-auto"><code>uv run python -m utils.compute_analytics</code></pre>
      <p class="text-sm text-gray-500 mt-3">Missing: <span id="analytics-missing-files"></span></p>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200" id="analytics-load-error" role="alert" hidden>
      <h2 class="text-xl font-bold text-gray-900 mb-2">Could not load analytics data</h2>
      <p class="text-gray-700 mb-3">Reload the page to try again.</p>
      <p class="text-sm text-gray-500" id="analytics-load-error-detail"></p>
    </div>

    <div id="analytics-dashboard" class="space-y-6" hidden>
      <form id="analytics-filters" class="bg-white rounded-lg shadow-md p-4 sm:p-6 border border-gray-200" aria-label="Dashboard filters">
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
          <div class="col-span-2 lg:col-span-1">
            <span class="block text-sm font-semibold text-gray-700 mb-2" id="ward-picker-label">Wards</span>
            <details class="relative" id="ward-picker">
              <summary class={`${controlClass} cursor-pointer list-none`} id="ward-summary" aria-describedby="ward-picker-label">All wards</summary>
              <div class="absolute z-20 mt-1 w-64 max-h-72 overflow-y-auto bg-white border border-gray-200 rounded-lg shadow-lg p-2">
                <button type="button" id="clear-wards" class="w-full text-left text-sm text-blue-600 hover:bg-gray-50 rounded px-2 py-1 mb-1">All wards</button>
                <div id="ward-options" class="grid grid-cols-3 gap-1" role="group" aria-labelledby="ward-picker-label"></div>
              </div>
            </details>
          </div>
          <label class="col-span-2 lg:col-span-1 block">
            <span class="block text-sm font-semibold text-gray-700 mb-2">Topic</span>
            <select name="lens" class={controlClass}>
              <option value="">All topics</option>
            </select>
          </label>
          <label class="block">
            <span class="block text-sm font-semibold text-gray-700 mb-2">From</span>
            <select name="from" class={controlClass}><option value="">Start</option></select>
          </label>
          <label class="block">
            <span class="block text-sm font-semibold text-gray-700 mb-2">To</span>
            <select name="to" class={controlClass}><option value="">Latest</option></select>
          </label>
          <label class="col-span-2 lg:col-span-1 block">
            <span class="block text-sm font-semibold text-gray-700 mb-2">Ward profile</span>
            <select id="profile-ward" class={controlClass}>
              <option value="">None</option>
            </select>
          </label>
        </div>
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3">
          <p id="date-window-status" class="text-sm text-gray-700 flex-1" aria-live="polite"></p>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="date-window-toggle" class="px-4 py-2 bg-blue-50 text-blue-700 font-semibold rounded-lg hover:bg-blue-100 transition-colors text-sm"></button>
            <button type="reset" class="px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors text-sm">
              Reset filters
            </button>
          </div>
        </div>
      </form>

      <div id="summary-tiles" class="grid grid-cols-2 lg:grid-cols-4 gap-4" aria-live="polite">
        {['Newsletters', 'Wards sending', 'Most mentioned topic', 'Biggest change'].map((label) => (
          <div class="bg-white rounded-lg shadow-md p-4 border border-gray-200">
            <p class="text-sm text-gray-600" data-tile-label>{label}</p>
            <p class="text-xl sm:text-2xl font-semibold text-gray-900 mt-1" data-tile-value></p>
            <p class="text-xs text-gray-500 mt-1" data-tile-detail></p>
          </div>
        ))}
      </div>

      <AnalyticsPanel
        id="term-explorer"
        title="Term explorer"
        description={`Search a word or two-word phrase. Months with fewer than ${MIN_MONTH_NEWSLETTERS_FOR_SHARES} newsletters are blank.`}
      >
        <form id="term-form" class="flex gap-2 mb-2" role="search">
          <label for="term-input" class="sr-only">Term</label>
          <input id="term-input" type="search" autocomplete="off" placeholder="e.g. bike lanes, zoning, budget" class={controlClass} />
          <button type="submit" class="px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">Explore</button>
        </form>
        <div id="term-suggestions" class="flex flex-wrap gap-2"></div>
        <p id="term-message" class="text-sm text-gray-700 mt-3" aria-live="polite"></p>
        <div id="term-results" data-export-region hidden>
          <div id="term-timeline" class="overflow-x-auto mt-3"></div>
          <h3 class="text-sm font-semibold text-gray-700 mt-4 mb-2" data-export-text>Top wards using this term</h3>
          <div id="term-wards" class="overflow-x-auto"></div>
        </div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="civic-calendar"
        title="Civic calendar"
        description="Wards mentioning each topic, by month. Click a topic for its detail."
      >
        <div data-export-region>
          <p class="text-xs text-gray-600 mb-2" data-export-text>
            Blue: more wards than the topic's average month. Red: fewer. Numbers are wards. Topics that swing most (highest minus lowest month) come first.
          </p>
          <div data-chart class="overflow-x-auto"></div>
          <h3 class="text-sm font-semibold text-gray-700 mt-5 mb-2" data-export-text id="topic-trends-title">Ward reach by topic</h3>
          <div id="topic-trends" class="overflow-x-auto"></div>
        </div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="topic-detail"
        title="Topic detail"
        description="One topic's ward reach by month, and which wards mentioned it."
        hidden
      >
        <div data-export-region>
          <h3 id="topic-detail-heading" tabindex="-1" class="text-lg font-semibold text-gray-900 focus:outline-none" data-export-text></h3>
          <div id="topic-detail-trend" class="overflow-x-auto"></div>
          <h4 class="text-sm font-semibold text-gray-700 mt-4 mb-2" data-export-text>Wards by month</h4>
          <div id="topic-detail-wards" class="overflow-x-auto"></div>
        </div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="ward-profile"
        title="Ward profile"
        description="One ward's newsletters against its own history and all wards."
        hidden
      >
        <div data-export-region>
          <p id="profile-message" class="text-sm text-gray-600" aria-live="polite" hidden></p>
          <div id="profile-content" class="space-y-5" hidden>
            <h3 id="profile-heading" class="text-lg font-semibold text-gray-900" data-export-text></h3>
            <dl id="profile-tiles" class="grid grid-cols-2 lg:grid-cols-4 gap-3">
              {['In these dates', 'All dates', 'Per month', 'Days between'].map((label) => (
                <div class="rounded-lg border border-gray-200 p-3">
                  <dt class="text-xs text-gray-600" data-export-text>{label}</dt>
                  <dd class="text-lg font-semibold text-gray-900 mt-1" data-tile-value data-export-text></dd>
                  <dd class="text-xs text-gray-500 mt-1" data-tile-detail data-export-text></dd>
                </div>
              ))}
            </dl>
            <div>
              <h4 class="text-sm font-semibold text-gray-700 mb-2" data-export-text>Newsletters per month</h4>
              <div id="profile-cadence" class="overflow-x-auto"></div>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-gray-700 mb-2" data-export-text>Topics by month</h4>
              <div id="profile-topics" class="overflow-x-auto"></div>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-gray-700 mb-2" data-export-text>Topics compared with all wards</h4>
              <div id="profile-comparison" class="overflow-x-auto"></div>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-gray-700 mb-1" data-export-text>Distinctive vocabulary</h4>
              <p class="text-xs text-gray-500 mb-2" data-export-text>
                Words this ward uses far more than the rest of the city, all dates. Click a bar to search.
              </p>
              <div id="profile-distinctive" class="overflow-x-auto"></div>
            </div>
          </div>
        </div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="rising-terms"
        title="Rising terms"
        description="Terms far more wards used in the latest full month than in a typical recent month. All wards and dates."
      >
        <div data-chart class="overflow-x-auto"></div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="sending-cadence"
        title="Sending cadence"
        description="Longest gaps between newsletters from the same alderman. A gap may be missed newsletters, not a pause."
        hasTable={false}
        exportable={false}
      >
        <div id="cadence-gaps" class="overflow-x-auto"></div>
      </AnalyticsPanel>

      <AnalyticsPanel
        id="coverage"
        title="About the data"
        description="Every panel reflects only the newsletters archived here. A ward with none here may still publish one."
      >
        <details class="text-sm" id="coverage-details">
          <summary class="cursor-pointer text-blue-600 hover:text-blue-700 font-medium">Newsletters per ward per month</summary>
          <div data-chart class="overflow-x-auto mt-2"></div>
        </details>
        <details class="mt-3 text-sm" id="lens-definitions">
          <summary class="cursor-pointer text-blue-600 hover:text-blue-700 font-medium">Topic phrase lists</summary>
          <div class="mt-2 space-y-3 text-gray-700" data-lens-definitions></div>
        </details>
      </AnalyticsPanel>
    </div>
  </div>
</Layout>

<script>
  import { loadCoreAnalyticsData } from '../lib/analytics-data';
  import { describeDataAsOf } from '../lib/analytics';

  function showSection(id: string): void {
    document.getElementById('analytics-loading')?.setAttribute('hidden', '');
    document.getElementById(id)?.removeAttribute('hidden');
  }

  function setText(id: string, text: string): void {
    const element = document.getElementById(id);
    if (element) element.textContent = text;
  }

  async function startAnalyticsPage(): Promise<void> {
    const result = await loadCoreAnalyticsData();
    if (result.status === 'missing') {
      setText('analytics-missing-files', result.missingFiles.join(', '));
      showSection('analytics-no-data');
      return;
    }
    if (result.status === 'failed') {
      setText('analytics-load-error-detail', result.message);
      showSection('analytics-load-error');
      return;
    }
    setText('analytics-data-as-of', describeDataAsOf(result.data.metadata));
    document.getElementById('analytics-data-as-of')?.removeAttribute('hidden');
    showSection('analytics-dashboard');
    // The charting bundle loads only when there is data to chart.
    const { startAnalyticsDashboard } = await import('../scripts/analytics-dashboard');
    startAnalyticsDashboard(result.data);
  }

  startAnalyticsPage().catch((error: unknown) => {
    setText('analytics-load-error-detail', error instanceof Error ? error.message : String(error));
    showSection('analytics-load-error');
  });
</script>
