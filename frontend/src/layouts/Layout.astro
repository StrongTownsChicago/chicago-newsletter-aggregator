---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME, buildCanonicalUrl, truncateDescription } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  /** Current page of a paginated listing; page 2+ is kept in the canonical URL. */
  canonicalPage?: number;
}

const { title, description, image, type = 'website', canonicalPage } = Astro.props;

const site = Astro.site ?? Astro.url.origin;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname, site, canonicalPage);
const metaDescription = truncateDescription(description);
const usesDefaultImage = !image;
const imageUrl = new URL(image ?? DEFAULT_SOCIAL_IMAGE.path, site).href;
const twitterCard = 'summary_large_image';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={imageUrl} />
    {usesDefaultImage && <meta property="og:image:width" content={String(DEFAULT_SOCIAL_IMAGE.width)} />}
    {usesDefaultImage && <meta property="og:image:height" content={String(DEFAULT_SOCIAL_IMAGE.height)} />}
    {usesDefaultImage && <meta property="og:image:alt" content={DEFAULT_SOCIAL_IMAGE.alt} />}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow focus:text-blue-600"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
