---
/**
 * Newsletters per month matching a search, over the search's date range. Each
 * month links to the search narrowed to that month. Space is reserved while
 * `scripts/search-timeline.ts` loads the counts; the card is removed if they
 * can't load.
 */
import type { TimelineMonthRange } from '../lib/search-timeline';

interface Props {
  query: string;
  range: TimelineMonthRange;
  /** The month the search's dates cover exactly, highlighted in the chart. */
  selectedMonth: string | null;
  /** Link that clears a selected month; null when none is selected. */
  allMonthsUrl: string | null;
  /** True when ward, source or topic filters narrow the results but not the chart. */
  hasOtherFilters: boolean;
}

const { query, range, selectedMonth, allMonthsUrl, hasOtherFilters } = Astro.props;
---

<section
  data-search-timeline-root
  data-query={query}
  data-start-month={range.startMonth}
  data-end-month={range.endMonth ?? undefined}
  data-selected-month={selectedMonth ?? undefined}
  data-testid="search-timeline"
  aria-labelledby="search-timeline-heading"
  class="bg-white rounded-lg border border-gray-200 px-4 pt-3 pb-2 mb-4"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 id="search-timeline-heading" class="text-sm font-semibold text-gray-900">
      “{query}” by month
    </h2>
    <div class="flex items-baseline gap-3">
      <p class="text-xs text-gray-500" data-timeline-summary></p>
      {allMonthsUrl && (
        <a href={allMonthsUrl} class="text-xs font-medium text-blue-600 hover:text-blue-700 whitespace-nowrap">All months</a>
      )}
    </div>
  </div>

  <div class="overflow-x-auto overflow-y-hidden">
    <ol class="flex items-end gap-1 min-h-[8.5rem] pt-2" data-timeline-bars aria-busy="true"></ol>
  </div>

  {hasOtherFilters && <p class="text-xs text-gray-500 mt-1">All wards and sources.</p>}
</section>

<script>
  import { initSearchTimeline } from '../scripts/search-timeline';

  initSearchTimeline();
</script>
