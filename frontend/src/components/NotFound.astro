---
import { HOME_PATH } from '../lib/site';
import { SEARCH_PARAM_NAMES, SEARCH_PATH } from '../lib/search-filters';
import { WARD_DIRECTORY_PATH } from '../lib/wards';

/** The body of a "not found" page: the page's one heading, a short explanation, and ways back in. */
interface Props {
  title?: string;
  message?: string;
  testId?: string;
}

const {
  title = 'Page not found',
  message = "This page doesn't exist or has moved.",
  testId = 'not-found',
} = Astro.props;

const WAYS_BACK = [
  { label: 'Recent newsletters', href: HOME_PATH },
  { label: 'Find your ward', href: WARD_DIRECTORY_PATH },
] as const;
---

<section class="container mx-auto px-4 py-16 sm:py-24 max-w-xl text-center" data-testid={testId}>
  <p class="text-sm font-semibold uppercase tracking-wide text-blue-700 mb-2">404</p>
  <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">{title}</h1>
  <p class="text-gray-600 mb-8">{message}</p>
  <form action={SEARCH_PATH} method="get" role="search" class="flex gap-2 mb-8">
    <label for="not-found-search" class="sr-only">Search newsletters</label>
    <input
      id="not-found-search"
      type="search"
      name={SEARCH_PARAM_NAMES.query}
      placeholder="Search newsletters"
      class="flex-1 min-w-0 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
    />
    <button type="submit" class="px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
      Search
    </button>
  </form>
  <nav aria-label="Ways back" class="flex flex-wrap justify-center gap-x-6 gap-y-2">
    {WAYS_BACK.map((link) => (
      <a href={link.href} class="text-blue-600 hover:text-blue-800 font-medium">{link.label}</a>
    ))}
  </nav>
</section>
