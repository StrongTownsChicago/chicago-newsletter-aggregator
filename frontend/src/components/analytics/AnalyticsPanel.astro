---
// A dashboard card: title, description, a caption the client script fills
// with the newsletter count behind the figure, the chart slot, and a
// collapsible table view. Exportable panels get a "Download PNG" button; the
// client script exports the slot element marked data-export-region (or the
// data-chart element when there is none).
interface Props {
  id: string;
  title: string;
  description: string;
  hasTable?: boolean;
  exportable?: boolean;
}

const { id, title, description, hasTable = true, exportable = true } = Astro.props;
---

<section id={id} class="bg-white rounded-lg shadow-md p-4 sm:p-6 border border-gray-200" aria-labelledby={`${id}-title`}>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 mb-1">
    <h2 id={`${id}-title`} class="text-xl font-bold text-gray-900">{title}</h2>
    {exportable && (
      <button
        type="button"
        data-export-png={id}
        disabled
        class="px-3 py-1 text-sm bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors disabled:opacity-50"
      >
        Download PNG
      </button>
    )}
  </div>
  <p class="text-sm text-gray-600 mb-1">{description}</p>
  <p class="text-xs text-gray-500 mb-4" data-caption></p>
  <slot />
  {hasTable && (
    <details class="mt-4 text-sm">
      <summary class="cursor-pointer text-blue-600 hover:text-blue-700 font-medium">Show table</summary>
      <div class="mt-2 overflow-x-auto max-h-96 overflow-y-auto" data-table></div>
    </details>
  )}
</section>
