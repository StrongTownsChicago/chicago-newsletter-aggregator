---
import type { NewsletterCardRow } from '../lib/server/newsletter-queries';
import { buildWardPath, parseWardParam } from '../lib/wards';
import { formatTopicLabel } from '../lib/topics';

interface Props {
  newsletter: NewsletterCardRow;
}
const { newsletter } = Astro.props;
const summaryId = `summary-${newsletter.id}`;
const wardNumber = parseWardParam(newsletter.sources?.ward_number ?? undefined);
const wardPath = wardNumber === null ? null : buildWardPath(wardNumber);
---
<article class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow p-6 border border-gray-200" data-testid="newsletter-card">
  <h2 class="text-2xl font-semibold mb-2" data-testid="newsletter-title">
    <a href={`/newsletter/${newsletter.id}`} class="hover:text-blue-600 transition-colors">
      {newsletter.subject}
    </a>
  </h2>
  
  <div class="flex flex-wrap items-center gap-2 text-sm text-gray-600 mb-3">
    {newsletter.sources?.name && (
      wardPath ? (
        <a href={wardPath} class="font-medium text-gray-800 hover:text-blue-600 transition-colors" data-testid="newsletter-source">{newsletter.sources.name}</a>
      ) : (
        <span class="font-medium text-gray-800" data-testid="newsletter-source">{newsletter.sources.name}</span>
      )
    )}
    {wardPath ? (
      <a href={wardPath} class="px-2 py-0.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-full text-xs font-semibold transition-colors" data-testid="newsletter-ward-link">
        Ward {wardNumber}
      </a>
    ) : newsletter.sources?.ward_number && (
      <span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded-full text-xs font-semibold">
        Ward {newsletter.sources.ward_number}
      </span>
    )}
    <span class="text-gray-400">•</span>
    <time datetime={newsletter.received_date}>
      {new Date(newsletter.received_date).toLocaleDateString('en-US', { 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
      })}
    </time>
  </div>

  {newsletter.summary && (
    <div class="mb-3">
      <p class="text-xs font-semibold text-gray-500 mb-1">SUMMARY</p>
      <div>
        <p id={summaryId} class="text-gray-700 line-clamp-2" data-testid="newsletter-summary">
          {newsletter.summary}
        </p>
        <button 
          type="button"
          onclick={`document.getElementById('${summaryId}').classList.toggle('line-clamp-2'); this.textContent = this.textContent.trim() === 'Show more' ? 'Show less' : 'Show more'`}
          class="text-sm text-blue-600 hover:text-blue-800 mt-1"
          data-testid="summary-toggle"
        >
          Show more
        </button>
      </div>
    </div>
  )}

  {newsletter.topics && newsletter.topics.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {newsletter.topics.map((topic: string) => (
        <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded-full">
          {formatTopicLabel(topic)}
        </span>
      ))}
    </div>
  )}
</article>