---
// One-line version of WardGlance for the top of a ward page, so the full box
// can sit below the newsletters without pushing them off screen.
import wardGlanceData from '../generated/ward-glance.json';
import { describeCadence, findWardGlance, listTopTopicLabels, type WardGlanceFile } from '../lib/ward-glance';

interface Props {
  wardNumber: number;
}

const SUMMARY_TOPIC_COUNT = 3;

const file = wardGlanceData as WardGlanceFile;
const glance = findWardGlance(file, Astro.props.wardNumber);
const cadence = glance ? describeCadence(glance) : null;
const topTopics = glance ? listTopTopicLabels(file, glance, SUMMARY_TOPIC_COUNT) : [];
---

{glance && cadence && (
  <p class="mt-2 text-sm text-gray-600" data-testid="ward-glance-summary">
    {cadence}
    {topTopics.length > 0 && <> · Most covered: {topTopics.join(' · ')}</>}
    · <a href="#ward-glance-heading" class="text-blue-600 underline hover:text-blue-800">At a glance</a>
  </p>
)}
