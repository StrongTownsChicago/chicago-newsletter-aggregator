---
import AuthButton from './AuthButton.astro';
import { notificationsEnabled } from '../lib/supabase';
import { SITE_NAME } from '../lib/seo';
import {
  HOME_PATH,
  SITE_TAGLINE,
  SOURCE_CODE_URL,
  buildPrimaryNavItems,
  isNavItemActive,
} from '../lib/site';

const navItems = buildPrimaryNavItems({
  showPreferences: notificationsEnabled() && Boolean(Astro.locals.user),
});
const currentPath = Astro.url.pathname;
// The homepage's h1 is the site name itself; every other page supplies its own h1.
const SiteNameHeading = currentPath === HOME_PATH ? 'h1' : 'p';
---

<header class="bg-white border-b border-gray-200 border-t-4 border-t-blue-500" data-testid="site-header">
  <div class="container mx-auto max-w-6xl px-4 pt-3 sm:pt-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
      <div class="flex min-w-0 items-center gap-2 sm:gap-3">
        <img src="/logo.svg" alt="" width="36" height="36" class="h-7 w-7 shrink-0 sm:h-9 sm:w-9" />
        <div class="min-w-0">
          <SiteNameHeading class="text-base sm:text-xl font-bold text-gray-900">
            <a
              href={HOME_PATH}
              class="hover:text-blue-600 transition-colors"
              data-testid="site-name"
            >
              {SITE_NAME}
            </a>
          </SiteNameHeading>
          <p class="hidden sm:block text-sm text-gray-600" data-testid="site-tagline">{SITE_TAGLINE}</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <AuthButton />
        <a
          href={SOURCE_CODE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 text-gray-600 hover:text-gray-900 transition-colors"
          title="View source on GitHub"
          aria-label="View source on GitHub"
          data-testid="header-github-link"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>

    <nav aria-label="Primary" class="mt-2 sm:mt-3" data-testid="site-nav">
      <ul class="flex flex-wrap gap-x-5 sm:gap-x-6">
        {navItems.map((item) => {
          const isActive = isNavItemActive(item, currentPath);
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'inline-block py-2 border-b-2 transition-colors',
                  isActive
                    ? 'border-blue-600 text-blue-600 font-semibold'
                    : 'border-transparent text-gray-600 hover:text-blue-600',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
