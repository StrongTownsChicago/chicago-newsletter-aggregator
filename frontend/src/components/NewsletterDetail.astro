---
import type { NewsletterDetailRow } from '../lib/server/newsletter-queries';
import { buildWardPath, parseWardParam } from '../lib/wards';
import { formatTopicLabel } from '../lib/topics';
import { formatReceivedDate } from '../lib/seo';

/** The newsletter detail page's article: subject, source, date, topics, summary and body. */
interface Props {
  newsletter: NewsletterDetailRow;
}

const { newsletter } = Astro.props;
const wardNumber = parseWardParam(newsletter.sources?.ward_number ?? undefined);
const wardPath = wardNumber === null ? null : buildWardPath(wardNumber);
---

  <article class="bg-white rounded-lg shadow-lg p-5 sm:p-8 border border-gray-200" data-testid="newsletter-detail">
    <header class="mb-8 border-b border-gray-200 pb-6">
      <h1 class="text-2xl sm:text-4xl font-bold text-gray-900 mb-4 break-words" data-testid="newsletter-detail-title">
        {newsletter.subject}
      </h1>
      
      <div class="space-y-2 mb-4">
        <!-- Source info row -->
        <div class="flex flex-wrap items-center gap-3 text-gray-600">
          {newsletter.sources?.name && (
            wardPath ? (
              <a href={wardPath} class="text-lg font-medium text-gray-800 hover:text-blue-600 transition-colors" data-testid="newsletter-detail-source">{newsletter.sources.name}</a>
            ) : (
              <span class="text-lg font-medium text-gray-800" data-testid="newsletter-detail-source">{newsletter.sources.name}</span>
            )
          )}
          {wardPath ? (
            <a href={wardPath} class="px-3 py-1 bg-blue-100 text-blue-800 hover:bg-blue-200 rounded-full text-sm font-semibold transition-colors" data-testid="newsletter-detail-ward-link">
              Ward {wardNumber}
            </a>
          ) : newsletter.sources?.ward_number && (
            <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-semibold">
              Ward {newsletter.sources.ward_number}
            </span>
          )}
          {newsletter.sources?.phone && (
            <a href={`tel:${newsletter.sources.phone}`} class="text-blue-600 hover:text-blue-800 hover:underline">
              📞 {newsletter.sources.phone}
            </a>
          )}
          {newsletter.sources?.email_address && (
            <a href={`mailto:${newsletter.sources.email_address}`} class="text-blue-600 hover:text-blue-800 hover:underline">
              ✉️ {newsletter.sources.email_address}
            </a>
          )}
        </div>
        
        <!-- Date row -->
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <time datetime={newsletter.received_date}>
            {formatReceivedDate(newsletter.received_date) ?? newsletter.received_date}
          </time>
        </div>
      </div>

      {newsletter.topics && newsletter.topics.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {newsletter.topics.map((topic: string) => (
            <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full">
              {formatTopicLabel(topic)}
            </span>
          ))}
        </div>
      )}

      {newsletter.summary && (
        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r">
          <p class="font-semibold text-sm text-blue-900 mb-1">Summary</p>
          <p class="text-gray-800">{newsletter.summary}</p>
        </div>
      )}
    </header>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600 prose-strong:text-gray-900" data-testid="newsletter-detail-content">
      {/* eslint-disable astro/no-set-html-directive -- raw_html is reduced to safe markup at ingestion (backend ingest/markup_sanitizer.py) */}
      {newsletter.raw_html ? (
        <div set:html={newsletter.raw_html} />
      ) : (
        <div class="whitespace-pre-wrap font-sans">{newsletter.plain_text}</div>
      )}
      {/* eslint-enable astro/no-set-html-directive */}
    </div>
  </article>
