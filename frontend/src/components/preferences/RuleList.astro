---
/** The user's notification rules, each with Edit (opens the rule modal) and Delete, or an empty state. */
import type { NotificationRule } from '../../lib/supabase';
import { ruleEditAttributes } from '../../lib/rule-form';
import { formatTopicLabel } from '../../lib/topics';

interface Props {
  notificationRules: NotificationRule[];
  maxRules: number;
  canCreateRule: boolean;
}

const { notificationRules, maxRules, canCreateRule } = Astro.props;
---

<!-- Notification Rules -->
<div class="bg-white shadow-sm border border-gray-200 rounded-xl p-6 sm:p-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-3">
      <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Notification Rules</h2>
        <p class="text-sm text-gray-600 mt-0.5">
          {notificationRules.length} of {maxRules} rules used
        </p>
      </div>
    </div>
    {canCreateRule ? (
      <button
        id="addRuleBtn"
        class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors shadow-sm"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Add Rule
      </button>
    ) : (
      <span class="inline-flex items-center gap-2 text-sm font-medium text-amber-700 bg-amber-50 border border-amber-200 px-4 py-2 rounded-lg">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        Maximum rules reached
      </span>
    )}
  </div>

  {notificationRules.length === 0 ? (
    <div class="text-center py-16 px-4 border-2 border-dashed border-gray-300 rounded-xl bg-gray-50">
      <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">No notification rules yet</h3>
      <p class="text-sm text-gray-600 mb-6 max-w-md mx-auto">
        Create rules to get notified when newsletters match your interests. You can filter by a search phrase, topics, and ward.
      </p>
      {canCreateRule && (
        <button
          id="addRuleBtn2"
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold py-2.5 px-6 rounded-lg transition-colors shadow-sm"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Create Your First Rule
        </button>
      )}
    </div>
  ) : (
    <div class="space-y-4">
      {notificationRules.map((rule) => (
        <div class="border border-gray-200 rounded-lg p-5 hover:shadow-md transition-shadow bg-white">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-3">
                <h3 class="text-lg font-semibold text-gray-900">{rule.name}</h3>
                {rule.is_active ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    Active
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"/>
                    </svg>
                    Disabled
                  </span>
                )}
                {rule.delivery_frequency === 'weekly' && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-200">
                    Weekly Report
                  </span>
                )}
              </div>
              {rule.topics && rule.topics.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {rule.topics.map((topic) => (
                    <span class="inline-flex items-center px-3 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                      {formatTopicLabel(topic)}
                    </span>
                  ))}
                </div>
              )}
              {rule.search_term && (
                <div class="mt-2 text-sm text-gray-700 bg-gray-50 px-3 py-1.5 rounded-md border border-gray-200 inline-flex items-center gap-2">
                   <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                   </svg>
                   <span>Matches: <strong>"{rule.search_term}"</strong></span>
                </div>
              )}
              {rule.ward_numbers && rule.ward_numbers.length > 0 && (
                <div class="mt-2 text-sm text-gray-600 flex flex-wrap gap-1 items-center">
                  <svg class="w-4 h-4 text-gray-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>Limited to Wards:</span>
                  {rule.ward_numbers.map((ward, i, wards) => (
                    <span class="font-medium">{ward}{i < wards.length - 1 ? ',' : ''}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="flex gap-2 flex-shrink-0">
              <button
                class="edit-rule-btn inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800 hover:bg-blue-50 px-3 py-1.5 rounded-md transition-colors"
                {...ruleEditAttributes(rule)}
                data-rule-active={rule.is_active}
              >
                <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                <span class="pointer-events-none">Edit</span>
              </button>
              <form action="/api/notifications/delete-rule" method="POST" enctype="application/x-www-form-urlencoded" class="inline">
                <input type="hidden" name="rule_id" value={rule.id} />
                <button
                  type="submit"
                  class="inline-flex items-center gap-1 text-sm font-medium text-red-600 hover:text-red-800 hover:bg-red-50 px-3 py-1.5 rounded-md transition-colors"
                  onclick="return confirm('Are you sure you want to delete this rule?')"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</div>
