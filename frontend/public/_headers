# Cloudflare Pages headers for static files from public/ (server-rendered
# routes set their own headers).

# Same policy and header as src/lib/content-security-policy.ts, which a test checks.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src * data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors *

# Analytics data: crawlers may fetch it to render /analytics, but the raw files
# stay out of search results. Names don't change between refreshes, so browsers
# revalidate on each load (a 304 when unchanged).
/analytics-data/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# Prerendered pages (/reports) skip the middleware that marks preview hosts
# noindex, so mark them here.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
