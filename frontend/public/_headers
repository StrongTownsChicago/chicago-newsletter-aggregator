# Cloudflare Pages headers for static files from public/ (server-rendered
# routes set their own headers).

# Analytics data: crawlers may fetch it to render /analytics, but the raw files
# stay out of search results. Names don't change between refreshes, so browsers
# revalidate on each load (a 304 when unchanged).
/analytics-data/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# Prerendered pages (/reports) skip the middleware that marks preview hosts
# noindex, so mark them here.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
