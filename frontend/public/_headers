# Cloudflare Pages headers for static files from public/ (server-rendered
# routes set their own headers).

# Analytics dashboard data: unlisted like /analytics (also disallowed in
# robots.txt). The files keep the same names on every refresh, so browsers
# revalidate on each load (a cheap 304 via ETag when unchanged), so a new deploy
# is picked up on the next page load rather than mixed with stale cached files.
/analytics-data/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# Prerendered pages (/reports) skip the middleware that marks preview hosts
# noindex, so mark them here.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
