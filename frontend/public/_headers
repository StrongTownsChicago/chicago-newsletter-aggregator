# Cloudflare Pages headers for static files from public/ (server-rendered
# routes set their own headers).

# Analytics dashboard data: unlisted like /analytics (also disallowed in
# robots.txt). The files keep the same names on every refresh, so browsers
# revalidate on each load (a cheap 304 via ETag when unchanged): a new deploy
# is picked up immediately and the files never mix versions.
/analytics-data/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache
